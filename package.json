{
  "name": "kingslityc-fullstack-node",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma Corporate KINGSLITYC - Software House de Sistemas Sob Encomenda e Hardware",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build:email": "esbuild src/emails/renderContactEmail.tsx --bundle --platform=node --format=cjs --external:react --external:react-dom --outfile=emails-dist/contact-email.js",
    "prestart": "npm run build:email",
    "predev:node": "npm run build:email",
    "start": "node server.js",
    "dev:node": "nodemon server.js",
    "dev": "vite",
    "build": "npm run build:email && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "lenis": "^1.3.26",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "resend": "^6.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
